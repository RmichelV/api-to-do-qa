# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# development | production (production enables Secure cookie, HTTPS redirect, HSTS)
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:4000

# MySQL 8.0+ / MariaDB 10.4+ (Hostinger compatible). See db/README.md.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=api_to_do_qa
DB_USER=qa_app
DB_PASSWORD=your-qa-app-password
# true only when the database is reached over a network (e.g. remote hosting)
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Optional: user for `npm run migrate` (design section 5.6). Falls back to DB_USER/DB_PASSWORD.
MIGRATE_DB_USER=qa_migrator
MIGRATE_DB_PASSWORD=another-local-password

# Auth feature (used from T5 on)
SESSION_DAYS=7
# 0 local, 1 behind a reverse proxy like Hostinger
TRUST_PROXY=0

MARIADB_ROOT_PASSWORD=your-local-root-password
MIGRATE_DB_USER=qa_migrator
MIGRATE_DB_PASSWORD=your-qa-migrator-password
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_NAME=api_to_do_qa_test
TEST_DB_USER=qa_migrator
TEST_DB_PASSWORD=your-qa-migrator-password
